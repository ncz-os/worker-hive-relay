[Unit]
Description=mnemos-node-relay reconciler (home side) — relay terminal/ -> land patch -> hive done
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@NODE_RELAY_USER@
WorkingDirectory=@NODE_RELAY_REPO@
EnvironmentFile=@NODE_RELAY_ENV@
ExecStart=@NODE_RELAY_PYTHON@ -m node_relay.reconciler --interval 15
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
