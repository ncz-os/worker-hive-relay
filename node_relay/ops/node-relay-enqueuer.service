[Unit]
Description=mnemos-node-relay enqueuer (home side) — hive jobs -> cloud relay bucket
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@NODE_RELAY_USER@
WorkingDirectory=@NODE_RELAY_REPO@
# Secrets via EnvironmentFile (mode 0600). See node_relay/setup_relay.sh.
EnvironmentFile=@NODE_RELAY_ENV@
ExecStart=@NODE_RELAY_PYTHON@ -m node_relay.enqueuer --interval 15
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
