[Unit]
Description=node-relay combined home runtime — enqueuer + reconciler
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@NODE_RELAY_USER@
WorkingDirectory=@NODE_RELAY_REPO@
EnvironmentFile=@NODE_RELAY_ENV@
ExecStart=@NODE_RELAY_PYTHON@ -m node_relay.home --enqueuer-interval 15 --reconciler-interval 15
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
