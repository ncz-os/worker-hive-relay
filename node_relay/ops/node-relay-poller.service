[Unit]
Description=node-relay poller (remote node side) — relay pending/ -> execute -> terminal/
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@NODE_RELAY_USER@
WorkingDirectory=@NODE_RELAY_REPO@
EnvironmentFile=@NODE_RELAY_ENV@
ExecStart=@NODE_RELAY_PYTHON@ -m node_relay.node_poller --interval 10 --executor local+cloud
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
